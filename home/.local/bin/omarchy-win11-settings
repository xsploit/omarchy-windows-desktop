#!/usr/bin/env bash
# User-owned launcher for the Windows-style desktop Settings window.
set -euo pipefail
section="${1:-display}"
case "$section" in
  display|sizing|sound|network|files|personalization|input|advanced) ;;
  *) printf 'Unknown Settings section: %s\n' "$section" >&2; exit 2 ;;
esac
if (( $# > 1 )); then printf 'Usage: omarchy-win11-settings [section]\n' >&2; exit 2; fi
DIR="$HOME/.config/omarchy-undercover/quickshell/win11-settings"
if ! command -v quickshell >/dev/null || [[ ! -f "$DIR/shell.qml" ]]; then
  command -v notify-send >/dev/null && notify-send 'Settings unavailable' 'Quickshell or the Settings configuration is missing.' || true
  exit 1
fi
if quickshell ipc -p "$DIR" call settings open "$section" >/dev/null 2>&1; then
  hyprctl dispatch focuswindow 'title:^(Desktop Settings)$' >/dev/null 2>&1 || true
  exit 0
fi
export DESKTOP_SETTINGS_SECTION="$section"
export QT_QUICK_CONTROLS_STYLE=Fusion
if ! quickshell -n -p "$DIR"; then
  command -v notify-send >/dev/null && notify-send 'Settings failed to open' 'Check the Settings launch log for details.' || true
  exit 1
fi
