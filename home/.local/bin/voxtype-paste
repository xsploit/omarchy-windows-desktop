#!/usr/bin/python3
"""Paste Voxtype's clipboard with the focused app's native input protocol."""
import ctypes as C
import json,os,subprocess,time
instances=json.loads(subprocess.check_output(['hyprctl','instances','-j']))
if not instances:raise SystemExit('No Hyprland session')
os.environ['HYPRLAND_INSTANCE_SIGNATURE']=instances[0]['instance']
os.environ['WAYLAND_DISPLAY']=instances[0]['wl_socket']
w=json.loads(subprocess.check_output(['hyprctl','activewindow','-j']))
if not w.get('address'):raise SystemExit('No focused window; text remains on clipboard')
time.sleep(.2)
if w.get('xwayland'):
 x=C.CDLL('libX11.so.6');xt=C.CDLL('libXtst.so.6')
 x.XOpenDisplay.argtypes=[C.c_char_p];x.XOpenDisplay.restype=C.c_void_p
 x.XStringToKeysym.argtypes=[C.c_char_p];x.XStringToKeysym.restype=C.c_ulong
 x.XKeysymToKeycode.argtypes=[C.c_void_p,C.c_ulong];x.XKeysymToKeycode.restype=C.c_ubyte
 x.XSync.argtypes=[C.c_void_p,C.c_int];x.XCloseDisplay.argtypes=[C.c_void_p]
 xt.XTestFakeKeyEvent.argtypes=[C.c_void_p,C.c_uint,C.c_int,C.c_ulong]
 d=x.XOpenDisplay(None)
 if not d:raise SystemExit('Cannot open XWayland; text remains on clipboard')
 try:
  ctrl=x.XKeysymToKeycode(d,x.XStringToKeysym(b'Control_L'));v=x.XKeysymToKeycode(d,x.XStringToKeysym(b'v'))
  for k,down in [(ctrl,1),(v,1),(v,0),(ctrl,0)]:xt.XTestFakeKeyEvent(d,k,down,0)
  x.XSync(d,0)
 finally:x.XCloseDisplay(d)
else:
 subprocess.run(['wtype','-M','shift','-k','Insert','-m','shift'],check=True)
