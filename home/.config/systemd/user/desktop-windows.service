[Unit]
Description=Mouse-friendly minimize and restore for Hyprland
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/desktop-windows serve
ExecStop=%h/.local/bin/desktop-windows restore-all
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
